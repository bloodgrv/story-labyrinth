# Docker image settings
DOCKER_IMAGE=bloodgrv/story-labyrinth
IMAGE_TAG=latest

# Application
APP_PORT=3000

# Data persistence (host paths)
DATA_PATH=./data
TAILSCALE_STATE_PATH=./tailscale-state

# Tailscale auth key - generate one at https://login.tailscale.com/admin/settings/keys
# Recommended: reusable + ephemeral, so re-creating the container doesn't require a new key each time.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MagicDNS name the app will be reachable at (https://tailscale.com/kb/1081/magicdns): http://<TS_HOSTNAME>:<APP_PORT>
TS_HOSTNAME=story-labyrinth
