# Docker image settings
DOCKER_IMAGE=bloodgrv/story-labyrinth
IMAGE_TAG=latest

# Application
APP_PORT=3000

# Data persistence (host path)
DATA_PATH=./data

# Host interface to publish the app's port on. Default (0.0.0.0, i.e. leave this unset) makes the
# app reachable from anywhere on your LAN — the intended default for this project's "direct LAN
# access, no Tailscale required" use case. If you don't want that (e.g. this host is also reachable
# from the public internet), uncomment the line below to bind loopback-only and reach the app via a
# reverse proxy or SSH tunnel instead — or use docker-compose.tailscale.yml, which never publishes a
# host port at all.
# BIND_HOST=127.0.0.1

# Set to true only if something in front of this app (a reverse proxy, Tailscale Serve, etc.)
# terminates real HTTPS — it makes the session cookie HTTPS-only, so plain-HTTP LAN/Tailscale access
# would silently stop working if you set this without actually having TLS in front. Leave unset
# (false) for the default plain-HTTP LAN/Tailscale setup this project targets.
# COOKIE_SECURE=true
